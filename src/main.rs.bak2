mod config;
mod state;
mod mexc;

use std::sync::Arc;
use std::time::{Duration, Instant};

type DynErr = Box<dyn std::error::Error + Send + Sync>;

#[tokio::main]
async fn main() -> Result<(), DynErr> {
    // Логування. RUST_LOG=info за замовчуванням якщо змінна не задана.
    tracing_subscriber::fmt()
        .with_env_filter(
            tracing_subscriber::EnvFilter::try_from_default_env()
                .unwrap_or_else(|_| tracing_subscriber::EnvFilter::new("info,mexc_ws=debug")),
        )
        .init();

    let cfg = Arc::new(config::Config::load("config.toml")?);
    println!("✅ Config loaded: account={}, symbols={:?}", cfg.account.label, cfg.trading.symbols);

    let state = state::State::new();
    println!("✅ State created");

    let client = mexc::http::MexcClient::new(cfg.account.mexc_uid.clone(), &cfg.account.proxy_url)?;
    println!("✅ MEXC client created");

    let bal = client.get_balance().await?;
    println!("✅ Balance: {} USDT", bal);

    let pos = client.get_positions(None).await?;
    println!("✅ Positions: {:?}", pos.get("data"));

    // === WS public test: 30 секунд ===
    println!("\n=== Starting MEXC public WS (30s test) ===");
    let cfg_ws = cfg.clone();
    let state_ws = state.clone();
    tokio::spawn(async move {
        mexc::ws_public::run_mexc_public_ws(cfg_ws, state_ws).await;
    });

    // Друкуємо top-of-book кожні 2 секунди протягом 30 секунд
    let t0 = Instant::now();
    while t0.elapsed() < Duration::from_secs(30) {
        tokio::time::sleep(Duration::from_secs(2)).await;
        let now = state::now_ms();
        for sym in &cfg.trading.symbols {
            if let Some(p) = state.mexc_prices.get(sym) {
                let age_ms = now.saturating_sub(p.timestamp_ms);
                println!(
                    "  MEXC {}: bid={:.6} ask={:.6} spread={:.4}% age={}ms",
                    sym,
                    p.bid,
                    p.ask,
                    (p.ask - p.bid) / p.bid * 100.0,
                    age_ms
                );
            } else {
                println!("  MEXC {}: <no data yet>", sym);
            }
        }
    }

    println!("\n=== Test finished ===");
    Ok(())
}
